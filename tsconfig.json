{
	"ts-node": {
		"require": ["tsconfig-paths/register"]
	},
	"compilerOptions": {
		"baseUrl": ".",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"paths": {
			"@/*": ["./src/*"]
		},
		"outDir": "dist",
		"sourceMap": true,
		"noImplicitAny": true,
		"target": "ES2021"
	},
	"include": ["src/**/*"]
}
